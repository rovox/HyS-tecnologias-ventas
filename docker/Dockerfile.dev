# Local development image for the api and web services (LOCAL-01).
# Dependencies are installed into the image; the source tree is bind-mounted by docker-compose.yml.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@11.21.0 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
# `prisma generate` runs in the api postinstall and needs the schema.
COPY apps/api/prisma apps/api/prisma

RUN CI=true pnpm install --frozen-lockfile
