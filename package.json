{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "setup": "pnpm install",
    "dev": "concurrently --kill-others --names api,web --raw \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "verify:dist": "pnpm --filter web verify:dist",
    "db:up": "pnpm --filter api db:up",
    "db:down": "pnpm --filter api db:down",
    "db:reset": "pnpm --filter api db:reset",
    "check": "pnpm --filter api build && pnpm --filter api test && pnpm --filter api test:e2e && pnpm --filter web lint && pnpm --filter web build && knip"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "knip": "^6.32.1",
    "only-allow": "^1.2.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
