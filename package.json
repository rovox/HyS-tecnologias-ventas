{
  "name": "hs-erp",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "ignore"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "setup": "pnpm install",
    "dev": "concurrently --kill-others --names api,web --raw \"pnpm --filter @hs-erp/api dev\" \"pnpm --filter @hs-erp/web dev\"",
    "dev:web": "pnpm --filter @hs-erp/web dev",
    "dev:api": "pnpm --filter @hs-erp/api dev",
    "build": "pnpm --filter @hs-erp/web build",
    "build:web": "pnpm --filter @hs-erp/web build",
    "start:web": "pnpm --filter @hs-erp/web start",
    "lint": "pnpm --filter @hs-erp/web lint",
    "verify:dist": "pnpm --filter @hs-erp/web verify:dist",
    "db:up": "pnpm --filter @hs-erp/api db:up",
    "db:down": "pnpm --filter @hs-erp/api db:down",
    "db:reset": "pnpm --filter @hs-erp/api db:reset",
    "check": "pnpm --filter @hs-erp/api build && pnpm --filter @hs-erp/api test && pnpm --filter @hs-erp/api test:e2e && pnpm --filter @hs-erp/web lint && pnpm --filter @hs-erp/web build && knip",
    "local:up": "docker compose up -d --build --wait",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v && docker compose up -d --build --wait",
    "local:test": "playwright test --pass-with-no-tests",
    "local:bundle": "node scripts/measure-bundle.mjs",
    "local:api": "node scripts/measure-api.mjs",
    "local:lighthouse": "node scripts/lighthouse-local.mjs",
    "local:gate": "node scripts/promote-gate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.4",
    "knip": "^6.32.1",
    "only-allow": "^1.2.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
