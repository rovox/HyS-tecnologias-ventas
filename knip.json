{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"rules": {
		"duplicates": "off"
	},
	"ignore": ["docs/**"],
	"workspaces": {
		"apps/web": {
			"entry": ["tools/*.{js,mjs}"],
			"project": ["src/**/*.{js,jsx,css}", "tools/*.{js,mjs}"],
			"paths": { "@/*": ["./src/*"] },
			"ignoreIssues": { "src/components/ui/**": ["exports"] }
		},
		"apps/api": {
			"entry": ["src/main.ts", "test/*.ts"],
			"project": ["src/**/*.ts", "prisma/**/*.{ts,prisma}", "test/*.ts"],
			"ignoreDependencies": ["@nestjs/schematics"]
		}
	}
}
