generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Sucursal {
  id            String         @id
  nombre        String         @db.VarChar(50)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  clients       Client[]
  quotations    Quotation[]
  relevamientos Relevamiento[]
  tasks         Task[]
  schedules     Schedule[]

  @@map("sucursales")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  name             String
  role             String
  phone            String         @default("")
  active           Boolean        @default(true)
  monthlyGoalBs    Decimal        @default(0) @db.Decimal(12, 2)
  sucursalId       String?
  sucursal         Sucursal?      @relation(fields: [sucursalId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sessions         Session[]
  activities       Activity[]
  quotations       Quotation[]    @relation("VendorQuotations")
  sellerGoals      SellerGoal[]
  relevamientos    Relevamiento[]
  createdTasks     Task[]         @relation("TaskCreator")
  assignedTasks    Task[]         @relation("TaskAssignee")
  schedulesVendedor Schedule[]    @relation("ScheduleVendedor")
  schedulesTecnico  Schedule[]    @relation("ScheduleTecnico")

  @@index([sucursalId])
  @@map("users")
}

model Session {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  startedAt  DateTime   @default(now())
  endedAt    DateTime?
  ip         String?
  userAgent  String?    @db.VarChar(512)
  activities Activity[]

  @@index([userId])
  @@map("sessions")
}

model Activity {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  at         DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([at])
  @@map("activities")
}

model Client {
  id              String         @id @default(uuid())
  nombre          String
  tipo            String
  contacto        String         @default("")
  email           String         @default("")
  telefono        String         @default("")
  direccion       String         @default("")
  sucursalId      String
  sucursal        Sucursal       @relation(fields: [sucursalId], references: [id])
  observaciones   String         @default("") @db.Text
  lastActivityAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  quotations      Quotation[]
  relevamientos   Relevamiento[]
  schedules       Schedule[]

  @@index([sucursalId])
  @@index([nombre])
  @@index([telefono])
  @@index([email])
  @@index([lastActivityAt])
  @@map("clients")
}

model Quotation {
  id             String             @id @default(uuid())
  numero         String             @unique
  titulo         String
  categoria      String
  categoriaId    String
  subcategoria   String             @default("")
  sucursalId     String
  sucursal       Sucursal           @relation(fields: [sucursalId], references: [id])
  sucursalNombre String             @default("")
  clienteId      String
  cliente        Client             @relation(fields: [clienteId], references: [id])
  estado         String             @default("borrador")
  motivoRechazo  String?            @db.Text
  monto          Decimal            @db.Decimal(12, 2)
  observacion    String             @default("") @db.Text
  archivo        String             @default("")
  archivoPdfUrl  String             @default("")
  vendedorId     String
  vendedor       User               @relation("VendorQuotations", fields: [vendedorId], references: [id])
  sellers        QuotationSeller[]
  sale           Sale?
  relevamientos  Relevamiento[]
  schedules      Schedule[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([vendedorId])
  @@index([clienteId])
  @@index([estado, sucursalId])
  @@index([estado, createdAt])
  @@map("quotations")
}

model QuotationSeller {
  quotationId   String
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  userId        String
  nombre        String    @default("")
  commissionPct Decimal   @db.Decimal(5, 2)

  @@id([quotationId, userId])
  @@map("quotation_sellers")
}

model Relevamiento {
  id           String    @id @default(uuid())
  usuarioId    String
  usuario      User      @relation(fields: [usuarioId], references: [id])
  clienteId    String
  cliente      Client    @relation(fields: [clienteId], references: [id])
  sucursalId   String
  sucursal     Sucursal  @relation(fields: [sucursalId], references: [id])
  fecha        DateTime  @db.Date
  lugar        String    @db.VarChar(200)
  notas        String?   @db.Text
  fotosUrl     Json?
  cotizacionId String
  cotizacion   Quotation @relation(fields: [cotizacionId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([cotizacionId])
  @@index([usuarioId])
  @@index([sucursalId, fecha])
  @@map("relevamientos")
}

model SellerGoal {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   User     @relation(fields: [usuarioId], references: [id])
  mes       DateTime @db.Date
  metaMonto Decimal  @db.Decimal(12, 2)
  metaCotiz Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, mes])
  @@index([mes])
  @@map("seller_goals")
}

model Sale {
  id          String        @id @default(uuid())
  quotationId String        @unique
  quotation   Quotation     @relation(fields: [quotationId], references: [id])
  total       Decimal       @db.Decimal(12, 2)
  status      String        @default("abierta")
  createdAt   DateTime      @default(now())
  jobs        SaleJob[]
  payments    SalePayment[]

  @@map("sales")
}

model SaleJob {
  id         String  @id @default(uuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id])
  titulo     String
  estado     String  @default("programado")
  monto      Decimal @default(0) @db.Decimal(12, 2)
  asignadoId String?

  @@index([saleId])
  @@map("sale_jobs")
}

model SalePayment {
  id     String   @id @default(uuid())
  saleId String
  sale   Sale     @relation(fields: [saleId], references: [id])
  monto  Decimal  @db.Decimal(12, 2)
  metodo String   @default("")
  nota   String   @default("")
  at     DateTime @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

model Schedule {
  id                 String     @id @default(uuid())
  type               String     @db.VarChar(32)
  clienteId          String
  cliente            Client     @relation(fields: [clienteId], references: [id])
  lugar              String     @default("") @db.VarChar(300)
  descripcionTrabajo String     @db.Text
  monto              Decimal    @default(0) @db.Decimal(12, 2)
  adelanto           Decimal    @default(0) @db.Decimal(12, 2)
  saldo              Decimal    @default(0) @db.Decimal(12, 2)
  fechaProgramada    DateTime
  horario            String?    @db.VarChar(32)
  fechaFinalizacion  DateTime?
  estado             String     @default("programado") @db.VarChar(32)
  sucursalId         String
  sucursal           Sucursal   @relation(fields: [sucursalId], references: [id])
  vendedorId         String?
  vendedor           User?      @relation("ScheduleVendedor", fields: [vendedorId], references: [id])
  tecnicoId          String?
  tecnico            User?      @relation("ScheduleTecnico", fields: [tecnicoId], references: [id])
  quotationId        String?
  quotation          Quotation? @relation(fields: [quotationId], references: [id])
  observaciones      String     @default("") @db.Text
  mapsLink           String     @default("") @db.VarChar(500)
  fotosUrl           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  tasks              Task[]

  @@index([fechaProgramada])
  @@index([sucursalId, estado])
  @@index([tecnicoId])
  @@index([vendedorId])
  @@index([clienteId])
  @@index([quotationId])
  @@map("schedules")
}

model Task {
  id           String    @id @default(uuid())
  titulo       String    @db.VarChar(200)
  descripcion  String?   @db.Text
  sucursalId   String
  sucursal     Sucursal  @relation(fields: [sucursalId], references: [id])
  creadorId    String
  creador      User      @relation("TaskCreator", fields: [creadorId], references: [id])
  asignadoId   String?
  asignado     User?     @relation("TaskAssignee", fields: [asignadoId], references: [id])
  estado       String    @default("pendiente")
  prioridad    String    @default("media")
  plazo        DateTime?
  cotizacionId String?
  scheduleId   String?
  schedule     Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  horario      String?   @db.VarChar(16)
  archivosUrl  Json?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sucursalId, estado])
  @@index([asignadoId])
  @@index([creadorId])
  @@index([completedAt])
  @@index([plazo])
  @@index([cotizacionId])
  @@index([scheduleId])
  @@map("tasks")
}

model QuotationCategory {
  id        String   @id
  label     String   @db.VarChar(100)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([label])
  @@map("quotation_categories")
}
